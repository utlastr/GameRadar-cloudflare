{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gameradar",
  "main": "cloudflare/src/worker.ts",
  "compatibility_date": "2026-10-30",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR_APP",
        "class_name": "RadarApp"
      }
    ]
  },
  "containers": [
    {
      "name": "gameradar-app",
      "class_name": "RadarApp",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "standard-1",
      "scheduling_policy": "default"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RadarApp"]
    }
  ]
}
